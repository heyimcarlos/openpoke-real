# OpenPoke Configuration
# Copy this file to .env and fill in your API keys

# Required: OpenRouter API key for LLM access
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Required: Composio API key and Gmail auth config ID
# Get these from https://composio.dev/
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_GMAIL_AUTH_CONFIG_ID=your_gmail_auth_config_id_here

# Required for durable execution and authenticated web chat
OPENPOKE_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/openpoke_test
# Optional: broker-assisted worker wakes. PostgreSQL remains authoritative.
# OPENPOKE_RABBITMQ_URL=amqp://openpoke:replace-me@rabbitmq.internal:5672/
OPENPOKE_JWT_SIGNING_KEY=replace-with-a-secret-at-least-32-bytes
OPENPOKE_JWT_ISSUER=https://auth.openpoke.local
OPENPOKE_JWT_AUDIENCE=openpoke-api
OPENPOKE_CHAT_ALLOWED_TENANT_ID=local
OPENPOKE_CHAT_ALLOWED_ACTOR_ID=local-user

# Local single-user development shims. Next.js rejects them when NODE_ENV=production.
# Production requires real browser-user authentication and server-side identity mapping.
OPENPOKE_WEB_BEARER_TOKEN=replace-with-a-signed-jwt
OPENPOKE_LOCAL_COMPOSIO_USER_ID=local-openpoke-user

# Optional: Server configuration
# OPENPOKE_HOST=0.0.0.0
# OPENPOKE_PORT=8001

# Optional: CORS configuration
# OPENPOKE_CORS_ALLOW_ORIGINS=*

# Optional: Documentation
# OPENPOKE_ENABLE_DOCS=1
# OPENPOKE_DOCS_URL=/docs
